# ─────────────────────────────────────────────
# ATLARS — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Never commit .env to git.
#
# Required to change: OPENROUTER_API_KEY
# Everything else works as-is for local dev.
# ─────────────────────────────────────────────

# ── OpenRouter ────────────────────────────────
# Required. Get a free key at https://openrouter.ai
# Free tier is sufficient for local development.
OPENROUTER_API_KEY=

# ── MongoDB ───────────────────────────────────
# Local dev: uses the Docker MongoDB container (no account needed)
# Production: replace with your MongoDB Atlas connection string
# Note: inside Docker the service name is used, not localhost
MONGO_URL=mongodb://mongo:27017
MONGO_DB_NAME=atlars

# ── Redis ─────────────────────────────────────
# Local dev: uses the Docker Redis container
# Production: replace with your Redis URL
REDIS_URL=redis://redis:6379

# ── Auth ──────────────────────────────────────
# Change this to a long random string in production.
# Generate one: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Backend ───────────────────────────────────
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ── Mobile App ────────────────────────────────
# Used by the Expo app to know where the backend is.
# For local dev on a physical device, replace localhost with your machine's local IP.
# Example: http://192.168.1.42:8000
API_BASE_URL=http://localhost:8000

# ── Environment ───────────────────────────────
# "development" or "production"
ENV=development
